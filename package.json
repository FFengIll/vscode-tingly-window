{
    "name": "vscode-window-mode",
    "displayName": "vscode-window-mode",
    "publisher": "FFengIll",
    "description": "",
    "version": "0.3.0",
    "engines": {
        "vscode": "^1.67.0"
    },
    "repository": {
        "url": "https://github.com/FFengIll/vscode-window-mode"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "vscode-window-mode.switch",
                "title": "switch"
            },
            {
                "command": "vscode-window-mode.fullWindow",
                "title": "Full Window"
            },
            {
                "command": "vscode-window-mode.showPanels",
                "title": "Show Panels"
            }
        ],
        "menus": {
            "editor/title/context": [
                {
                    "command": "vscode-window-mode.fullWindow",
                    "group": "navigation@1000",
                    "when": "!windowModeIsNA"
                },
                {
                    "command": "vscode-window-mode.showPanels",
                    "group": "navigation@1000",
                    "when": "windowModeIsNA"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^9.1.1",
        "@types/node": "~14.18.63",
        "@types/vscode": "^1.67.0",
        "@typescript-eslint/eslint-plugin": "^8.43.0",
        "@typescript-eslint/parser": "^8.43.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.35.0",
        "glob": "^11.0.3",
        "mocha": "^9.2.2",
        "typescript": "^4.9.5"
    }
}
