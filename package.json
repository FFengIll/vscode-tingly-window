{
	"name": "vscode-window-mode",
	"displayName": "vscode-window-mode",
	"publisher": "FFengIll",
	"description": "",
	"version": "0.0.4",
	"engines": {
		"vscode": "^1.67.0"
	},
	"repository": {
		"url": "https://github.com/FFengIll/vscode-window-mode"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:vscode-window-mode.switch"
	],
	"main": "./out/extension.js",
