{
    "name": "tingly-window",
    "displayName": "Tingly Window",
    "publisher": "Tingly-Dev",
    "description": "",
    "version": "0.25.1107",
    "engines": {
        "vscode": "^1.67.0"
    },
    "repository": {
        "url": "https://github.com/FFengIll/vscode-tingly-window"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "activationEvents": [
        "onCommand:tingly-window.switch",
        "onCommand:tingly-window.fullWindow",
        "onCommand:tingly-window.showPanels",
        "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "tingly-window.switch",
                "title": "Tingly Window: Switch Mode"
            },
            {
                "command": "tingly-window.fullWindow",
                "title": "Tingly Window: Full Window"
            },
            {
                "command": "tingly-window.showPanels",
                "title": "Tingly Window: Show Panels"
            }
        ],
        "menus": {
            "editor/title/context": [
                {
                    "command": "tingly-window.fullWindow",
                    "group": "navigation@1000"
                },
                {
                    "command": "tingly-window.showPanels",
                    "group": "navigation@1000"
                }
            ]
        },
        "configuration": {
            "title": "SelectLine Status Bar",
            "properties": {
                "selectline.displayFormat": {
                    "type": "string",
                    "default": "Selected %d Lines",
                    "description": "Display format of selected lines. The format can use node.js util.format. Argument into display format is line count only. You can display with octicon like $(three-bars) Selected line: %d."
                },
                "selectline.alignment": {
                    "type": "string",
                    "enum": [
                        "left",
                        "right"
                    ],
                    "default": "left",
                    "description": "Show on the left or right in the status bar."
                },
                "selectline.statusbarPriority": {
                    "type": "number",
                    "default": 100,
                    "description": "The priority of display in the status bar. Higher value means shown the left."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^9.1.1",
        "@types/node": "~14.18.63",
        "@types/vscode": "^1.67.0",
        "@typescript-eslint/eslint-plugin": "^8.43.0",
        "@typescript-eslint/parser": "^8.43.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.35.0",
        "glob": "^11.0.3",
        "mocha": "^9.2.2",
        "typescript": "^4.9.5"
    }
}